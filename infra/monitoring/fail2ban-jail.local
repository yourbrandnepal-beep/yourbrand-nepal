[DEFAULT]
bantime = 1h
findtime = 10m
maxretry = 5
banaction = nftables-multiport

[sshd]
enabled = true
port = ssh
logpath = %(sshd_log)s
maxretry = 3
bantime = 24h

[rrchat-synapse-auth]
enabled = true
port = http,https
filter = rrchat-synapse-auth
logpath = /opt/rrchat1/infra/data/caddy_logs/access.log
maxretry = 6
findtime = 5m
bantime = 1h
